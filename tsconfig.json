{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "types/**/*.d.ts",
    "frontend/modules/shared/api.js"
  ],
  "exclude": [
    "node_modules",
    "frontend/public"
  ]
}
