{
  "name": "clinica-veterinaria-vetusta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --import ./load-env.js server.js",
    "dev": "node --import ./load-env.js --watch server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/tailwind.css --minify",
    "build:css:watch": "tailwindcss -i ./src/input.css -o ./public/tailwind.css --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "dotenv": "^16.4.7",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1"
  },
  "overrides": {
    "qs": "^6.14.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.8"
  }
}
