{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "code.html",
          "aviso-legal.html",
          "privacidad.html",
          "cookies.html",
          "sitemap.html",
          "booking.js",
          "reviews.js",
          "screen.png",
          "reviews.local.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
