{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "code.html",
          "aviso-legal.html",
          "privacidad.html",
          "cookies.html",
          "sitemap.html",
          "auth.html",
          "dashboard.html",
          "pet-detail.html",
          "admin.html",
          "terminos-legales.html",
          "condiciones-uso.html",
          "politica-privacidad.html",
          "booking.js",
          "reviews.js",
          "image-sources.js",
          "i18n.js",
          "supabase-client.js",
          "auth.js",
          "dashboard.js",
          "pet-detail.js",
          "admin.js",
          "client-area.css",
          "google-logo.svg",
          "robots.txt",
          "sitemap.xml",
          "favicon.svg",
          "reviews.local.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
