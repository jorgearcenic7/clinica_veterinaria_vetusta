// Tests Vitest. Importan directamente los .js de backend/lib, por eso comparten
// resolución de módulos NodeNext con tsconfig.backend.json.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2020"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": [
    "types/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
